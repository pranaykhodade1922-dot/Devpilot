{
  "name": "devpilot-security",
  "version": "0.1.0",
  "description": "Developer security toolkit for modern applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "devpilot": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "devpilot": "tsx src/cli/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "security",
    "cli",
    "vulnerability",
    "audit",
    "developer-tools",
    "devsecops"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "semver": "^7.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/semver": "^7.5.8",
    "tsup": "^9.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
